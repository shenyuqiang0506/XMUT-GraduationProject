# Template only. Export values in your shell/IDE; Spring does not load .env automatically.
DB_URL=jdbc:mysql://localhost:3306/booking_db?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=replace-with-database-user
DB_PASSWORD=replace-with-database-password
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=replace-with-rabbitmq-user
RABBITMQ_PASSWORD=replace-with-rabbitmq-password
RABBITMQ_VHOST=/
# Optional profiles: nacos,ai
NACOS_SERVER_ADDR=localhost:8848
NACOS_USERNAME=replace-with-nacos-user
NACOS_PASSWORD=replace-with-nacos-password
AI_BASE_URL=https://api.openai.com
AI_API_KEY=replace-with-model-api-key
AI_MODEL=replace-with-supported-model
API_DOCS_ENABLED=false
